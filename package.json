{
  "name": "vessyl-website-current",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 4180 --strictPort",
    "build": "vite build && node scripts/write-route-index.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check.mjs && node scripts/figma-freeze.mjs",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
